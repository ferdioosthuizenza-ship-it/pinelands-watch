# Copy this file to .env and fill in the values. Never commit .env.
#
# Only PUBLIC values go here. Anything that starts with EXPO_PUBLIC_ is bundled
# into the app and is visible to anyone who inspects the app, so it must be
# safe to share. The Supabase "anon" key is designed to be public; Row Level
# Security in the database is what keeps data private.
#
# The Supabase SERVICE ROLE key and any AI keys must NEVER appear here or
# anywhere in this repository. They live only in Supabase Edge Function secrets.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
